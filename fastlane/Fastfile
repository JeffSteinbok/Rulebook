# Entry point for the App Store listing. Run:
#
#     ./Scripts/asc-key.sh && fastlane listing
#
# Scripts/testflight.sh still owns building and uploading the binary.

default_platform(:ios)

APP_IDENTIFIER = "net.steinbok.Rulebook".freeze
# __dir__ is fastlane/, which is also the cwd when this file is evaluated —
# a repo-root-relative path does not resolve here.
KEY_JSON = File.expand_path("asc_api_key.json", __dir__).freeze

platform :ios do
  desc "Push metadata, screenshots, age rating and privacy labels to App Store Connect"
  lane :listing do
    unless File.exist?(KEY_JSON)
      UI.user_error!("#{KEY_JSON} is missing — run ./Scripts/asc-key.sh first.")
    end

    key = JSON.parse(File.read(KEY_JSON))

    # Also sets the Spaceship token, which is how the privacy-details upload
    # authenticates: that action takes no api_key of its own.
    app_store_connect_api_key(
      key_id: key["key_id"],
      issuer_id: key["issuer_id"],
      key_filepath: key["key_filepath"],
      in_house: false
    )

    # Declares "Data Not Collected". True today because the app has no backend;
    # revisit the moment anything resembling analytics is added.
    upload_app_privacy_details_to_app_store(
      app_identifier: APP_IDENTIFIER,
      json_path: File.expand_path("app_data_usages.json", __dir__),
      skip_json_file_saving: true
    )

    # Reads the Deliverfile. Shows an HTML preview and waits for confirmation;
    # never submits for review on its own.
    deliver
  end

  desc "Verify auth and show what would be pushed, without writing anything"
  lane :listing_check do
    key = JSON.parse(File.read(KEY_JSON))
    app_store_connect_api_key(
      key_id: key["key_id"],
      issuer_id: key["issuer_id"],
      key_filepath: key["key_filepath"],
      in_house: false
    )

    # Read-only: proves the key works and the app is reachable before a run
    # that writes. Spaceship raises here if auth or the identifier is wrong.
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No app found for #{APP_IDENTIFIER}") if app.nil?
    UI.success("Authenticated. App: #{app.name} (#{app.bundle_id})")

    version = app.get_edit_app_store_version
    if version
      UI.success("Editable version #{version.version_string} — #{version.app_store_state}")
    else
      UI.important("No editable version. Create one in App Store Connect, or")
      UI.important("deliver will have nothing to write the listing into.")
    end
  end
end
